---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Pin {
  n: number;
  x: number;
  y: number;
  href?: string;
  label: string;
}
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  pins?: Pin[];
  sizes: string;
  eager?: boolean;
  widths?: number[];
}
const { src, alt, caption, pins = [], sizes, eager = false, widths = [640, 960, 1400, 2000] } = Astro.props;
---
<figure class="plate">
  <div class="plate__frame">
    <Image
      src={src}
      alt={alt}
      widths={widths.filter((w) => w <= src.width)}
      sizes={sizes}
      format="webp"
      quality={80}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
    {pins.map((p) =>
      p.href ? (
        <a class="pin" href={p.href} style={`left:${p.x}%;top:${p.y}%`} aria-label={`${p.n}번 ${p.label}`}>{p.n}</a>
      ) : (
        <span class="pin" style={`left:${p.x}%;top:${p.y}%`} aria-hidden="true">{p.n}</span>
      ),
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
