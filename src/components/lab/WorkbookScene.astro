---
import { Image } from 'astro:assets';
import nfc from '../../assets/learning/nfc-tag-structure.webp';
import wifiRssi from '../../assets/learning/workbook/wifi-rssi.webp';
import ssidMap from '../../assets/learning/workbook/ssid-map.webp';
import wpaPmf from '../../assets/learning/workbook/wpa-pmf.webp';
import channel from '../../assets/learning/workbook/channel.webp';
import bleAd from '../../assets/learning/workbook/ble-ad.webp';
import blePair from '../../assets/learning/workbook/ble-pair.webp';
import interference from '../../assets/learning/workbook/interference.webp';
import ir from '../../assets/learning/workbook/ir.webp';
import subghz from '../../assets/learning/workbook/subghz.webp';
import gps from '../../assets/learning/workbook/gps.webp';
import firmware from '../../assets/learning/workbook/firmware.webp';
import csv from '../../assets/learning/workbook/csv.webp';

// 순서는 실습 목록 번호와 같다. 0번이 01 NFC 기본 실습이다.
interface Props { index: number; }
const scenes = [
  { image: nfc, alt: '투명한 원형 접착 태그 안에 감긴 은색 안테나 코일과 가운데 작은 칩', caption: '전지 없는 태그, 코일과 칩 하나' },
  { image: wifiRssi, alt: '집 평면도 위 공유기에서 방마다 퍼지는 신호와 휴대용 측정기', caption: '방을 옮기며 신호의 빈틈 찾기' },
  { image: ssidMap, alt: '평면도 위 두 공유기와 각각의 연결을 살피는 휴대폰', caption: '이름 하나, 서로 다른 기기 주소' },
  { image: wpaPmf, alt: '공유기를 둘러싼 여러 겹의 보호막과 세 개의 방패', caption: '보안 설정마다 지키는 구간은?' },
  { image: channel, alt: '여러 무선 기기와 서로 다른 높이의 주파수 봉우리가 보이는 화면', caption: '같은 시간, 다른 채널의 풍경' },
  { image: bleAd, alt: '이어폰에서 퍼지는 근거리 신호와 책상 위 휴대폰', caption: '벽 너머에서도 광고가 보일까?' },
  { image: blePair, alt: '자물쇠로 연결된 휴대폰과 이어폰, 연결 확인과 보호를 비교하는 표시', caption: '연결되었다는 것과 믿는다는 것' },
  { image: interference, alt: '공유기와 전자레인지 등 여러 생활 기기의 신호를 살피는 측정기', caption: '신호의 세기만으로 원인을 알까?' },
  { image: ir, alt: '리모컨에서 TV로 향하는 적외선 신호와 버튼별 명령을 그린 노트', caption: '같은 버튼, 같은 명령, 다른 거리' },
  { image: subghz, alt: '두 실험 송수신기 쌍에서 고정된 신호 패턴과 바뀌는 패턴을 비교하는 책상', caption: '고정 코드와 매번 바뀌는 코드' },
  { image: gps, alt: '위성 신호를 받는 위치 기기와 위치를 대조할 지도, 시계, 나침반', caption: '위치 하나를 세 가지 근거로 보기' },
  { image: firmware, alt: '파일의 일치 여부를 확인하는 노트북과 서명 봉투, 연결된 회로 기판', caption: '파일이 같은가, 출처를 믿는가?' },
  { image: csv, alt: '식별 정보를 가린 표와 자물쇠가 보이는 노트북, 공유기와 태그', caption: '식별자는 가리고, 관찰은 남기기' },
];
const scene = scenes[Astro.props.index];
---
<figure class="workbook-scene">
  <Image src={scene.image} alt={scene.alt} widths={[450, 900]} sizes="(min-width: 768px) 45vw, 90vw" loading="lazy" decoding="async" />
  <figcaption>{scene.caption}</figcaption>
</figure>
