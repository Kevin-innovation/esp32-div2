];
const scene = scenes[Astro.props.index];
---
<figure class="workbook-scene">
  <svg viewBox="0 0 320 120" role="img" aria-label={scene.caption}>
    <path d={scene.path} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    {scene.labels.map(([x,y,text]) => <text x={x} y={y} text-anchor="middle">{text}</text>)}
  </svg>
  <figcaption>{scene.caption}</figcaption>
</figure>
