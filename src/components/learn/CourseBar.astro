---
// Python 과정 1~8차시 전용 진행바. 학습 흐름 바(path-top)의 고정 자리를 그대로 쓰므로 고정 요소를 새로 쌓지 않는다.
// 서버 HTML만으로(JS 꺼짐) 차시 목록 펼치기와 이전/다음 이동이 된다. JS는 지금 읽는 절 표시(문서의 목차 앵커 기준),
// 목차·패널의 aria-current="location", 읽은 위치 선, Escape·밖 클릭 닫기를 더한다. 완료 여부는 저장하거나 주장하지 않는다.
import { COURSE } from '../../data/pythonCourseMap';
import { url } from '../../lib/url';

interface Props { path: string }
const { path } = Astro.props;
const i = COURSE.findIndex((c) => c.href === path);
const now = COURSE[i];
const prev = COURSE[i - 1];
const next = COURSE[i + 1];
const STAGES = ['기초', '직접 작성', '미션별 응용'] as const;
const arrow = (d: string) => `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="${d}" /></svg>`;
---
<nav class="path-top wrap course-bar" aria-label="Python 과정 진행" data-course-bar>
  <div class="course-bar__row">
    <details class="course-bar__menu" data-course-menu>
      <summary class="course-bar__toggle">
        <span class="course-bar__count">{now.n}/8차시</span>
        <span class="course-bar__title">{now.title}</span>
        <span class="sr">· 과정 차시와 이 차시의 절 목록 열기</span>
      </summary>
      <div class="course-bar__panel">
        <div class="course-bar__cols">
          <div>
            <p class="course-bar__label" id="course-bar-lessons">Python·pandas·Colab 과정 8차시</p>
            <ol class="course-bar__lessons" aria-labelledby="course-bar-lessons">
              {STAGES.map((st) => COURSE.filter((c) => c.stage === st).map((c, k) => (
                <li class:list={{ 'course-bar__stage-start': k === 0 }} data-stage={k === 0 ? st : undefined}>
                  <a href={url(c.href)} aria-current={c.n === now.n ? 'page' : undefined}>
                    <span class="course-bar__n">{c.n}</span>
                    <span>{c.title}<span class="course-bar__meta"> · {c.minutes}분</span></span>
                  </a>
                </li>
              )))}
            </ol>
          </div>
          <div data-sections-box hidden>
            <p class="course-bar__label" id="course-bar-sections">{now.n}차시 안에서</p>
            <ol class="course-bar__sections" aria-labelledby="course-bar-sections" data-sections></ol>
          </div>
        </div>
        <p class="course-bar__foot small"><a href={url('/learn/python-colab/#course')}>과정 차시표</a> · <a href={url('/learn/#route')}>기본 수업 0~6으로 돌아가기</a></p>
      </div>
    </details>
    <p class="course-bar__now" data-now hidden><span class="course-bar__now-label">지금</span> <span data-now-text></span></p>
    <div class="course-bar__step">
      {prev ? (
        <a class="course-bar__go" href={url(prev.href)} aria-label={`이전 차시: ${prev.n}차시 ${prev.title}`} title={`${prev.n}차시 ${prev.title}`}><Fragment set:html={arrow('M15 6l-6 6 6 6')} /><span class="course-bar__go-text">이전</span></a>
      ) : <span class="course-bar__go is-off" aria-hidden="true"><Fragment set:html={arrow('M15 6l-6 6 6 6')} /><span class="course-bar__go-text">이전</span></span>}
      {next ? (
        <a class="course-bar__go" href={url(next.href)} aria-label={`다음 차시: ${next.n}차시 ${next.title}`} title={`${next.n}차시 ${next.title}`}><span class="course-bar__go-text">다음</span><Fragment set:html={arrow('M9 6l6 6-6 6')} /></a>
      ) : <span class="course-bar__go is-off" aria-hidden="true"><span class="course-bar__go-text">다음</span><Fragment set:html={arrow('M9 6l6 6-6 6')} /></span>}
    </div>
  </div>
  <span class="course-bar__progress" aria-hidden="true"><span data-progress></span></span>
</nav>

<script>
  // 지금 절 계산과 패널 닫기는 사이트 공통 모듈(src/lib/tocSpy.ts)을 쓴다. 여기서는 절 목록 복제, 바 글자, 읽은 위치 선만 맡는다.
  import { onToc, wireMenu } from '../../lib/tocSpy';

  const bar = document.querySelector<HTMLElement>('[data-course-bar]');
  const menu = bar?.querySelector<HTMLDetailsElement>('[data-course-menu]');
  if (bar && menu) {
    const box = bar.querySelector<HTMLElement>('[data-sections-box]')!;
    const list = bar.querySelector<HTMLOListElement>('[data-sections]')!;
    const nowBox = bar.querySelector<HTMLElement>('[data-now]')!;
    const nowText = bar.querySelector<HTMLElement>('[data-now-text]')!;
    const progress = bar.querySelector<HTMLElement>('[data-progress]')!;
    const copies: HTMLAnchorElement[] = [];
    let built = false;
    onToc((k, items) => {
      if (!built) {
        // 절 목록: 문서 목차와 같은 앵커(대상이 실제로 있는 것만)
        built = true;
        items.forEach((it) => {
          const li = document.createElement('li');
          const copy = document.createElement('a');
          copy.href = it.link.hash;
          copy.textContent = it.label;
          li.append(copy);
          list.append(li);
          copies.push(copy);
        });
        box.hidden = nowBox.hidden = items.length === 0;
        document.documentElement.classList.add('has-course-bar');
      }
      copies.forEach((c, j) => (j === k ? c.setAttribute('aria-current', 'location') : c.removeAttribute('aria-current')));
      nowText.textContent = k < 0 ? '차시 첫머리' : items[k].label;
    });
    const line = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      progress.style.transform = `scaleX(${max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0})`;
    };
    addEventListener('scroll', line, { passive: true });
    line();
    wireMenu(menu, bar, bar.querySelector<HTMLElement>('.course-bar__panel')!);
  }
</script>
