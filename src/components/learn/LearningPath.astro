---
import { LEARNING_PATH } from '../../data/learn';
import { COURSE } from '../../data/pythonCourseMap';
import CourseBar from './CourseBar.astro';
import { url } from '../../lib/url';

interface Props {
  where: 'top' | 'bottom';
  path: string;
}
const { where, path } = Astro.props;
const index = LEARNING_PATH.findIndex((s) => s.href === path);
const step = LEARNING_PATH[index];
const prev = LEARNING_PATH[index - 1];
const next = LEARNING_PATH[index + 1];
const name = (s: { n: number; title: string }) => `${s.n}단계: ${s.title}`;
const mission = path.startsWith('/lab/');
const catalog = path === '/lab/';
const prereq = path.startsWith('/learn/python-colab/') || path === '/learn/mission-code/';
/** Python 과정 차시는 학습 흐름 바 자리에 과정 진행바를 둔다 */
const course = COURSE.some((c) => c.href === path);
const labels = ['배경', '기기 준비', '첫 태그', 'NFC 원리', 'Wi-Fi', '보안', '실험·보고서'];
---
{where === 'top' && course && <CourseBar path={path} />}
{where === 'top' && !course && (step ? (
  <nav class="path-top wrap" aria-label="수업 단계 내비게이션">
    <ol class="path-steps">
      {LEARNING_PATH.map((s) => (
        <li>
          <a href={url(s.href)} aria-label={name(s)} aria-current={s.n === step.n ? 'step' : undefined} title={name(s)}>
            <span>{s.n}단계</span>
            <strong>{labels[s.n]}</strong>
          </a>
        </li>
      ))}
    </ol>
  </nav>
) : (
  <nav class="path-top wrap" aria-label="학습 순서">
    <p class="path-top__now"><strong>{catalog ? '실습 미션 목록' : mission ? '선택 미션' : prereq ? '선수 학습 · 선택' : '참고 자료'}</strong></p>
    <p class="small">{mission && '기본은 0~6단계의 NFC 수업입니다. 기본 수업을 마쳤다면 관심 있는 주제를 선택하세요. '}<a href={url('/learn/#route')}>기본 수업 0~6으로 돌아가기</a></p>
  </nav>
))}

{where === 'bottom' && !course && (step ? (
  <nav class="path-next wrap" aria-label="이전과 다음 단계">
    <p class="path-next__done"><strong>다음으로 넘어가도 좋을 때:</strong> {step.done}</p>
    {next ? (
      <div class="path-next__links">
        <a class="path-link path-link--prev" href={url(prev ? prev.href : '/learn/')}>
          <small><svg class="path-link__arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M20 12H5M11 6l-6 6 6 6" /></svg>이전</small>
          <span>{prev ? name(prev) : '학습 안내'}</span>
        </a>
        <a class="path-link path-link--next" href={url(next.href)}>
          <small>다음 단계</small>
          <span>{name(next)}</span>
          <span class="small">{next.does}</span>
          <span class="path-link__cta">{next.n}단계 시작하기<svg class="path-link__arrow" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6" /></svg></span>
        </a>
      </div>
    ) : (
      <div class="path-next__links">
        <a class="path-link path-link--prev" href={url(prev.href)}>
          <small><svg class="path-link__arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M20 12H5M11 6l-6 6 6 6" /></svg>이전</small>
          <span>{name(prev)}</span>
        </a>
        <div class="path-link path-link--end">
          <small>마지막 단계입니다</small>
          <span><a href="#report">보고서 쓰기</a>, <a href="#interview">자소서와 면접 준비</a></span>
          <span class="small">다음 탐구는 <a href={url('/lab/')}>선택 실습 미션</a>에서 고릅니다. <a href={url('/learn/projects/')}>배경 기술노트</a>도 참고하세요.</span>
        </div>
      </div>
    )}
  </nav>
) : (
  <nav class="path-next wrap" aria-label="학습 순서로 돌아가기">
    <a class="path-link" href={url('/learn/')}>
      <small>{mission ? '선택 미션에서 기본 수업으로' : '참고 자료를 다 봤다면'}</small>
      <span>기본 수업 0~6으로 돌아가기</span>
    </a>
  </nav>
))}

{where === 'bottom' && step && next && (
  <script is:inline>
    // 다음 카드가 화면에 들어오면 한 번만 짧게 강조한다(3회 후 멈춤). 지원하지 않으면 정적 강조만 남는다.
    (() => {
      const el = document.querySelector('.path-link--next');
      if (!el || !('IntersectionObserver' in window)) return;
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        el.classList.add('is-cued');
        io.disconnect();
      }, { threshold: 0.6 });
      io.observe(el);
    })();
  </script>
)}
