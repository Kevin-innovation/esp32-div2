---
// 과정 차시의 한 단계: 설명 → 예제 → 빈칸(힌트, 정답) → 직접 작성(확인 셀, 정답) → 함정 → 이유 → 변형 → 미션 원문.
// 모든 출력은 scripts/check-python-course.ts가 실제로 실행한 결과(python-course-output.json)다.
import CodeBlock from '../CodeBlock.astro';
import Rich from './Rich.astro';
import { checkCode, filled, type Lesson, type Step } from '../../data/pythonCourse';
import out from '../../data/python-course-output.json';
import { url } from '../../lib/url';

interface Props { lesson: Lesson; step: Step; i: number }
const { lesson, step: s, i } = Astro.props;
const runs = out as Record<string, { out: string; err: string | null }>;
const id = `${lesson.slug}/${s.id}`;
const shown = (k: string) => {
  const r = runs[`${id}/${k}`];
  if (!r) throw new Error(`실행 결과 없음: ${id}/${k} (check-python-course.ts --write)`);
  return [r.out, r.err].filter(Boolean).join('\n') || '(출력 없음)';
};
const f = (k: string) => `${lesson.slug}-${i + 1}-${s.id}-${k}.py`;
---
<article class="read-block lesson-step" id={`step-${s.id}`} aria-labelledby={`h-step-${s.id}`}>
  <h2 id={`h-step-${s.id}`}>{lesson.chain ? s.title : `${i + 1}. ${s.title}`}</h2>
  {s.learn.map((t) => <p><Rich text={t} /></p>)}

  {s.example && (
    <>
      <h3 class="read-label">예제 보기</h3>
      <CodeBlock code={s.example} file={f('example')} label="예제 · 새 셀에 붙여 실행" />
      <CodeBlock kind="output" code={shown('example')} file="output" label="실행 결과" />
    </>
  )}

  <h3 class="read-label">{lesson.chain ? '이번 단계 코드: 빈칸 채우기' : '빈칸 채우기'}</h3>
  <p class="small muted">___를 채우기 전에 실행하면 오류가 나는 것이 정상입니다.{lesson.chain && ' 앞 단계 셀을 모두 실행한 같은 노트에서 이어 씁니다.'}</p>
  <CodeBlock code={s.blank.code} file={f('blank')} label="빈칸 ___ 채우기" />
  <details class="lesson-step__fold"><summary>힌트</summary><p>{s.blank.hint}</p></details>
  <details class="lesson-step__fold">
    <summary>{lesson.chain ? '완성 코드와 출력' : '정답과 출력'}</summary>
    <CodeBlock code={filled(s.blank)} file={f('answer')} label={lesson.chain ? '완성 코드' : '빈칸 정답'} />
    <CodeBlock kind="output" code={shown('filled')} file="output" label={s.check ? '실행 결과(확인 셀까지)' : '실행 결과'} />
  </details>
  {s.check && (
    <>
      <h3 class="read-label">확인 셀</h3>
      <p class="small">내 코드 셀 바로 아래 새 셀에 붙여 실행합니다. ‘확인 통과’가 나오면 다음 단계로 갑니다. AssertionError가 나면 쉼표 뒤의 값이 지금 내 값입니다.</p>
      <CodeBlock code={checkCode(s.check)} file={f('check')} label="확인 셀" />
    </>
  )}

  {s.write && (
    <div class="read-task">
      <p><strong class="read-task__kind">빈 셀에 직접 작성</strong> {s.write.task}</p>
      {s.write.setup && <CodeBlock code={s.write.setup} file={f('setup')} label="주어진 준비 코드 · 먼저 실행" />}
      <p class="small">예제를 보지 않고 새 셀에 직접 씁니다. 다 쓰면 아래 확인 셀을 그 아래에 붙여 실행합니다. 준비 코드와 확인 셀만 실행하면 실패하는 것이 정상입니다.</p>
      <CodeBlock code={checkCode(s.write.check)} file={f('check')} label="확인 셀" />
      <details>
        <summary>정답 예와 출력</summary>
        <CodeBlock code={s.write.answer} file={f('solution')} label="정답 예(다르게 써도 확인 셀을 통과하면 됩니다)" />
        <CodeBlock kind="output" code={shown('write')} file="output" label="실행 결과" />
      </details>
    </div>
  )}

  {s.pitfall && (
    <>
      <h3 class="read-label">함정: 이렇게 쓰면</h3>
      <CodeBlock code={s.pitfall.code} file={f('pitfall')} label={lesson.chain ? '앞 단계 뒤에 실행' : '함정 코드'} />
      <CodeBlock kind="output" code={shown('pitfall')} file="output" label="실행 결과(오류는 마지막 줄)" />
      <p><Rich text={s.pitfall.note} /></p>
    </>
  )}

  <h3 class="read-label">왜 필요한가</h3>
  <p><Rich text={s.why} /></p>

  {s.variant && (
    <div class="read-task">
      <p><strong class="read-task__kind">변형 문제</strong> <Rich text={s.variant.q} /></p>
      {s.variant.code && <CodeBlock code={s.variant.code} file={f('variant')} label="먼저 결과를 예측하고 실행" />}
      <details>
        <summary>{s.variant.code ? '실행 결과와 해설' : '해설'}</summary>
        {s.variant.code && <CodeBlock kind="output" code={shown('variant')} file="output" label="실행 결과" />}
        <p><Rich text={s.variant.answer} /></p>
      </details>
    </div>
  )}

  <h3 class="read-label">미션 원문으로 돌아가기</h3>
  {s.refs.map((r) => (
    <div class="lesson-ref">
      <p class="small"><a href={url(r.href)}>{r.n === '노트북' ? 'NFC 미션의 분석 노트북' : `${r.n} ${r.title} 9장`}</a> · <Rich text={r.note} /></p>
      <CodeBlock code={r.excerpt.text} file={r.id === 'notebook' ? 'nfc-analysis.py' : `${r.id}-colab.py`} label={r.id === 'notebook' ? 'NFC 노트북 원문' : `${r.id}-colab.py 원문`} start={r.excerpt.start} save={false} />
    </div>
  ))}
</article>
