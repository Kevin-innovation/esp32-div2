---
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import LearningPath from '../components/learn/LearningPath.astro';
import { REFERENCE_LINKS } from '../data/learn';
import { CHECKED } from '../data/sources';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const references = REFERENCE_LINKS;
const path = (Astro.url.pathname.replace(base, '') || '/').replace(/\/?$/, '/');
const inReference = references.some(([href]) => path.startsWith(href));
const inLearning = !inReference && (path.startsWith('/learn/') || path === '/start/');
// 학습 흐름은 학습 순서 페이지와 참고 자료 모두에 붙는다. 홈, 학습 안내, 404만 뺀다.
const showPath = path !== '/' && path !== '/learn/' && path !== '/learn/glossary/' && !path.startsWith('/404');
const current = (href: string) => path === href ? 'page' : path.startsWith(href) ? 'true' : undefined;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      (function () {
        var d = document.documentElement, t = null;
        d.classList.add('js');
        try { t = localStorage.getItem('esp32div.theme'); } catch (e) {}
        if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
      })();
    </script>
    <style is:global>html, body { overflow-x: clip; }</style>
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <header class="site-head">
      <div class="wrap site-head__row">
        <a class="wordmark" href={`${base}/`} aria-label="ESP32-DIV 실험 노트 홈">ESP32-DIV 실험 노트</a>
        <nav class="nav" aria-label="주요 메뉴">
          <a href={`${base}/learn/`} aria-current={inLearning ? (path === '/learn/' ? 'page' : 'true') : undefined}>수업 시작</a>
          <a href={`${base}/lab/`} aria-current={current('/lab/')}>실습 미션</a>
          <details class="nav-reference" id="reference-nav">
            <summary aria-current={inReference ? 'true' : undefined}>참고 자료</summary>
            <ul aria-label="참고 자료 목록">
              {references.map(([href, label]) => <li><a href={`${base}${href}`} aria-current={current(href)}>{label}</a></li>)}
            </ul>
          </details>
        </nav>
        <button class="switch" type="button" role="switch" aria-checked="false" id="theme-switch">
          <span>다크 모드</span>
          <span class="switch__track" aria-hidden="true"><span class="switch__thumb"></span></span>
        </button>
      </div>
    </header>
    <main id="main">
      {showPath && <LearningPath where="top" path={path} />}
      <slot />
      {showPath && <LearningPath where="bottom" path={path} />}
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <p class="site-foot__statement">CiferTech의 공식 사이트가 아닙니다. 이 기기에서는 부팅, 메뉴 표시, NFC 태그 읽기까지 확인했고 다른 기능은 미검증입니다.</p>
        <div class="site-foot__links">
          <p class="muted">자료 확인일은 {CHECKED}입니다.</p>
          <p><a href="https://github.com/cifertech/ESP32-DIV#readme" rel="noopener">원본 프로젝트의 사용 조건과 경고 보기</a></p>
          <p class="muted">DLAB 수성 · Dev by Kevin</p>
        </div>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var d = document.documentElement, b = document.getElementById('theme-switch');
        var references = document.getElementById('reference-nav');
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && references.open) { references.open = false; references.querySelector('summary').focus(); }
        });
        document.addEventListener('click', function (event) {
          if (references.open && !references.contains(event.target)) references.open = false;
        });
        var sync = function () { b.setAttribute('aria-checked', String(d.dataset.theme === 'dark')); };
        var chosen = function () { try { return localStorage.getItem('esp32div.theme'); } catch (e) { return null; } };
        sync();
        b.addEventListener('click', function () {
          d.dataset.theme = d.dataset.theme === 'dark' ? 'light' : 'dark';
          sync();
          try { localStorage.setItem('esp32div.theme', d.dataset.theme); } catch (e) {}
        });
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
          if (chosen()) return;
          d.dataset.theme = e.matches ? 'dark' : 'light';
          sync();
        });
      })();
    </script>
  </body>
</html>
