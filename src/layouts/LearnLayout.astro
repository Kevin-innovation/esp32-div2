---
import Base from './Base.astro';
import Sources from '../components/Sources.astro';
import type { SourceId } from '../data/sources';

interface Props {
  title: string;
  heading: string;
  lead: string;
  description: string;
  toc?: [string, string][];
  sources: SourceId[];
  compactHeader?: boolean;
  sourcesChecked?: string;
}
const { title, heading, lead, description, toc = [], sources, compactHeader = false, sourcesChecked } = Astro.props;
---
<Base title={`${title} | ESP32-DIV 실험 노트`} description={description}>
  <div class="wrap">
    <header class:list={["page-head", { "page-head--compact": compactHeader }]}>
      <h1>{heading}</h1>
      <p class="lead">{lead}</p>
    </header>
    <div class="doc">
      <div class="doc__main">
        <slot />
        <Sources ids={sources} checked={sourcesChecked} />
      </div>
      {toc.length > 0 && (
        <nav class="doc__aside toc" data-toc aria-label="이 장의 목차">
          <h2>이 장</h2>
          <ol>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
        </nav>
      )}
    </div>
  </div>
</Base>
