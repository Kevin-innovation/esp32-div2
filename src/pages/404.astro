---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="찾을 수 없는 페이지 | ESP32-DIV V2.1 실험 노트" description="요청한 페이지를 찾을 수 없습니다.">
  <div class="wrap">
    <header class="page-head">
      <h1>이 주소에는 페이지가 없습니다</h1>
      <p class="lead">주소가 바뀌었거나 잘못 입력되었습니다.</p>
      <div class="btn-row"><a class="btn" href={url('/')}>홈으로 가기</a></div>
    </header>
  </div>
</Base>
