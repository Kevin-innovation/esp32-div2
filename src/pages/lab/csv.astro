---
import LabGuide from '../../components/lab/LabGuide.astro';
import { CsvExportPart, CsvNotesPart, CsvReportPart, CsvSourcePart, CsvWorkPart } from '../../components/lab/PseudonymLab';
import { csvColab } from '../../lib/colab';
import { csvSummary, pseudonymize, readSource } from '../../lib/pseudonym';
import { csvTable, noteFields, noteLabels } from '../../lib/workbooks/render';
import output from '../../lib/workbooks/colab-output.json';
import { golden, guide } from '../../lib/workbooks/csv';

const source = readSource(golden.original);
const pseudo = pseudonymize(source, golden.actions);
const pick = (...keys: string[]) => noteFields(guide, keys);
---
<LabGuide guide={guide} scene={12} golden={csvTable(source)} expected={csvSummary(source, pseudo)} code={csvColab(golden.original, pseudo.csv)} output={(output as Record<string, string>).csv ?? ''} codeFile="csv-real-original.csv와 csv-real-pseudonymized.csv">
  <CsvNotesPart slot="design" client:load fields={pick('question', 'hypothesis', 'controls')} />
  <CsvSourcePart slot="record" client:load golden={golden} />
  <CsvExportPart slot="data" client:load />
  <CsvWorkPart slot="analysis" client:load />
  <CsvNotesPart slot="interpret" client:load fields={pick('interpretation', 'conclusion')} />
  <CsvNotesPart slot="defense" client:load fields={pick('defense', 'limits')} />
  <CsvNotesPart slot="application" client:load fields={pick('application')} />
  <CsvNotesPart slot="explain" client:load fields={pick('explain')} />
  <CsvReportPart slot="report" client:load title={guide.title} labels={noteLabels(guide)} />
</LabGuide>
