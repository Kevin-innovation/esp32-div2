---
import Base from '../../layouts/Base.astro';
import Evidence from '../../components/Evidence.astro';
import Think from '../../components/learn/Think.astro';
import Sources from '../../components/Sources.astro';
import TermLink from '../../components/learn/TermLink.astro';
import { Chart, CsvPanel, Interview, NoteFields, PythonPanel, Records, Report, SaveState } from '../../components/lab/NfcLab';
import { SOURCES } from '../../data/sources';
import { url } from '../../lib/url';

const toc = [
  ['overview', '이 실습으로 파악하는 것'],
  ['golden-case', 'NFC 골든 케이스'],
  ['design', '질문, 가설, 설계'],
  ['record', '결과 입력'],
  ['chart', '인식률 그래프'],
  ['data', 'CSV 백업과 이동'],
  ['python', '선택: Python·Colab'],
  ['security', '보안 평가와 방어'],
  ['interpret', '해석과 결론'],
  ['unexpected', '예상과 다른 결과'],
  ['report', '보고서'],
  ['interview', '자소서와 면접'],
];

const reportSources = [SOURCES.emvco, SOURCES.ntag, SOURCES.metal, SOURCES.nistCsf].map((s) => ({ title: s.title, url: s.url }));
const colabQuickCode = String.raw`# NFC 실험 CSV의 실제 기록만 분석합니다.
# 업로드 전 UID·실명·SSID/BSSID·개인 메모는 삭제하거나 가명 처리하세요.
import io
import matplotlib.pyplot as plt
import pandas as pd
from google.colab import files

uploaded = files.upload()
name = next((n for n in uploaded if n.endswith('.csv') and 'notes' not in n.lower()), None)
if name is None:
    raise ValueError('관찰 CSV(nfc-experiment.csv)를 하나 올려 주세요.')

raw = pd.read_csv(io.BytesIO(uploaded[name]), encoding='utf-8-sig', keep_default_na=False)
required = {'trial', 'condition', 'contents', 'distance_cm', 'orientation', 'success', 'note', 'data_type'}
missing_columns = required - set(raw.columns)
if missing_columns:
    raise ValueError(f'필수 열이 없습니다: {sorted(missing_columns)}')

# NFC CSV에서 success=1은 정한 시간 안에 새 태그를 읽은 관찰, 0은 읽지 못한 관찰입니다.
# 빈 값·0/1이 아닌 값은 미측정/잘못된 행으로 따로 세고 성공으로 바꾸지 않습니다.
raw['success_num'] = pd.to_numeric(raw['success'], errors='coerce')
missing = raw[raw['success_num'].isna() | ~raw['success_num'].isin([0, 1])]
data = raw[(raw['data_type'] == 'real') & raw['success_num'].isin([0, 1])].copy()
if data.empty:
    raise ValueError('data_type=real인 관찰 행이 없습니다. 데모 행은 실제 분석에서 제외됩니다.')

summary = (data.groupby('condition', sort=False)['success_num']
    .agg(attempts='size', successes='sum')
    .assign(failures=lambda t: t['attempts'] - t['successes']))
summary['rate'] = summary['successes'] / summary['attempts']
summary = summary.rename(columns={'attempts': '시도', 'successes': '성공', 'failures': '실패', 'rate': '인식률'})
print(f'실제 관찰 {len(data)}행 · 결측/무효 {len(missing)}행')
display(summary.assign(인식률=lambda t: (t['인식률'] * 100).round(1).astype(str) + '%'))

ax = summary[['성공', '실패']].plot(kind='bar', stacked=True, color=['#2f6b4f', '#b7b2a7'], figsize=(7, 4))
ax.set_title('NFC 조건별 성공·실패 횟수')
ax.set_xlabel('배치 조건')
ax.set_ylabel('시도 횟수')
plt.tight_layout()
plt.show()

# 이 표는 태그를 읽은 비율만 보여 줍니다. 결제 승인·카드 복제·공격 성공률은 계산하지 않습니다.
display(data[['trial', 'condition', 'distance_cm', 'orientation', 'success_num', 'note']].head(10))`;
---
<Base title="NFC는 지갑·가방 안에서도 인식될까? | 실험 노트" description="실험용 NFC 태그로 단독, 지갑, 가방 조건의 인식률을 비교하고 CSV, 파이썬 분석, 보고서까지 만드는 탐구 프로젝트입니다.">
  <div class="wrap">
    <header class="page-head">
      <p class="page-back"><a href={url('/lab/')}>실험 워크북 목록</a></p>
      <h1>NFC는 지갑·가방 안에서도 인식될까?</h1>
      <p class="lead">실험용 태그로 직접 재고, 내가 입력한 값으로만 결론을 냅니다.</p>
      <p class="small muted">NFC와 <a href={url('/lab/wifi-rssi/')}>Wi-Fi RSSI</a>를 포함한 웹 워크북 7개를 사용할 수 있습니다. <a href={url('/lab/')}>실습 미션 목록</a>에서 BLE·IR·간섭·GPS·CSV와 개발 예정인 심화 6개를 살펴보세요.</p>
    </header>
    <div class="doc">
      <div class="doc__main">
        <div class="callout callout--warn" style="margin-bottom: var(--space-lg)">
          <p><strong>실제 신용카드, 체크카드, 교통카드, 학생증은 쓰지 않습니다.</strong> 실험 중에는 지갑에서도 빼 두세요. 직접 산 실험용 NFC 태그만 사용합니다.</p>
        </div>
        <SaveState client:load />
        <noscript><p class="callout callout--warn">기록 입력과 그래프는 자바스크립트가 켜져 있어야 동작합니다. 실험 방법과 보안 설명은 그대로 읽을 수 있습니다.</p></noscript>

        <section class="lab-section" id="overview" aria-labelledby="h-overview" style="margin-top: var(--space-xl)">
          <h2 id="h-overview">이 실습으로 파악하는 것</h2>
          <p class="lead">이 페이지는 ‘카드를 복제하는 법’이 아니라, <strong>실험용 태그가 어떤 조건에서 읽히고 그 관찰을 어디까지 보안 주장으로 연결할 수 있는지</strong>를 배우는 흐름입니다.</p>
          <ol>
            <li><strong>생활 질문:</strong> 교통카드·출입 배지처럼 가까이 대는 장면을 떠올리고, “지갑이나 가방이 사이에 있으면 읽힘이 달라질까?”를 한 문장으로 씁니다. <span class="small muted">산출물: 탐구 질문·가설</span> → <a href="#design">설계로 이동</a></li>
            <li><strong>태그·리더 준비:</strong> 실험용 태그와 Card Reader만 준비하고, 실제 결제 카드·타인 태그·출입장치는 사용하지 않습니다. <span class="small muted">산출물: 준비 체크·허가 범위</span> → <a href={url('/start/#first-scan')}>기기 준비</a></li>
            <li><strong>골든 케이스 직접 읽기:</strong> 대기 화면에서 태그를 새로 읽고 Info의 UID 길이·ATQA/SAK·P4~P7 표시를 확인합니다. <span class="small muted">산출물: 첫 읽기 관찰</span> → <a href="#golden-case">골든 케이스</a></li>
            <li><strong>조건별 반복:</strong> 같은 태그·리더·5초 기준으로 단독·빈 지갑·천 가방을 각각 5회 기록합니다. <span class="small muted">산출물: 실제/미관찰/미측정 원자료</span> → <a href="#record">결과 입력</a></li>
            <li><strong>브라우저 분석:</strong> 이 페이지의 표·그래프로 조건별 성공/시도와 인식률을 비교합니다. Python·Colab은 선택이며 실제 CSV의 <code>data_type=real</code>만 분석합니다. <span class="small muted">산출물: 표·그래프·결측 설명</span> → <a href="#chart">그래프</a> / <a href="#python">선택 코드</a></li>
            <li><strong>방어·보고서·1분 설명:</strong> ‘읽힘’과 ‘결제 승인·복제 가능’의 차이를 설명하고, 근거·한계·방어·다음 질문을 보고서와 자기소개서 문장으로 정리합니다. <span class="small muted">산출물: 보고서·1분 설명</span> → <a href="#security">보안 평가</a> / <a href="#report">보고서</a></li>
          </ol>
          <div class="callout">
            <p><strong>막히면 순서를 되돌립니다.</strong> 태그가 안 읽히면 골든 케이스의 대기 화면으로 돌아가 한 번만 위치를 바꾸고, 그래도 안 되면 ‘미관찰’로 남깁니다. 브라우저 입력이 막히면 공책 표와 계산으로 같은 순서를 완성하고, 실제 관찰과 데모를 섞지 않습니다.</p>
          </div>
          <details>
            <summary>자바스크립트 없이 공책으로 완주하기</summary>
            <ol>
              <li>질문·가설·허가 범위와 고정 조건을 적습니다.</li>
              <li>골든 케이스의 화면 순서와 확인한 표시를 그립니다.</li>
              <li>단독·지갑·가방 행을 각각 5개 만들고 성공은 1, 실패는 0, 시작하지 못한 시도는 미측정으로 구분합니다.</li>
              <li>조건별 성공÷시도×100을 계산하되, 결측을 0회 성공으로 바꾸지 않습니다.</li>
              <li>읽힘의 범위·결제와의 차이·방어·한계·다음 실험을 한 문단과 1분 설명으로 씁니다.</li>
            </ol>
          </details>
        </section>

        <section class="lab-section" id="golden-case" aria-labelledby="h-golden-case">
          <h2 id="h-golden-case">NFC 골든 케이스: 먼저 이 한 번을 통과</h2>
          <p>반복 실험 전에 ‘새 태그를 읽고 화면 값을 확인하는 기본 경로’를 한 번 완주합니다. 사용자가 제공한 화면에서는 <strong>PN532 리더, 7바이트 UID, ATQA 0044, SAK 00, MIFARE Ultralight-compatible 표시와 P4~P7 사용자 메모리 샘플</strong>을 확인했습니다. 이 값은 실험용 태그 화면의 관찰 범위이며, 실제 신용카드의 결제 인증·암호 키·복제 가능성을 뜻하지 않습니다.</p>
          <div class="callout callout--warn">
            <p><strong>안전 경계:</strong> 결제 카드·교통카드·출입 배지·타인 태그를 읽지 않습니다. 카드 정보를 복제하거나 결제를 시도하지 않습니다. 실험용 태그와 교사 승인 사례만 사용합니다.</p>
          </div>
          <div class="table-wrap" tabindex="0" role="region" aria-label="NFC 골든 케이스 순서">
            <table>
              <caption>새 읽기 화면을 확인하는 순서</caption>
              <thead><tr><th scope="col">순서</th><th scope="col">화면·행동</th><th scope="col">기록할 사실</th><th scope="col">완료/대체</th></tr></thead>
              <tbody>
                <tr><td>1</td><td><code>Waiting for tag...</code></td><td>Card Reader가 새 대기 상태인지</td><td>이전 OK/Info 화면이면 Back·Exit·Cancel로 다시 대기</td></tr>
                <tr><td>2</td><td>태그를 가까이 대기 → <code>Tag detected</code></td><td>새 UID가 예상 태그와 맞는지, 5초 안인지</td><td>맞으면 성공 후보, 안 보이면 미관찰로 기록</td></tr>
                <tr><td>3</td><td>Info에서 UID 길이·타입·ATQA·SAK 확인</td><td>이번 읽기의 표시만 공책에 요약</td><td>이전 화면을 새 성공으로 세지 않음</td></tr>
                <tr><td>4</td><td>Next에서 P4~P7 표시 확인</td><td>사용자 메모리 샘플과 화면 페이지</td><td>페이지가 안 열리면 ‘읽기 성공’과 ‘메모리 확인’을 분리</td></tr>
                <tr><td>5</td><td>대기 화면으로 돌아와 CSV/표에 기록</td><td>조건·거리·방향·성공 1/실패 0·메모</td><td>시작하지 못한 시도는 미측정, 수치를 꾸미지 않음</td></tr>
              </tbody>
            </table>
          </div>
          <p><strong>예상 결과:</strong> 같은 태그를 같은 위치에 두면 UID와 태그 유형이 반복되고, 단독 조건이 지갑·가방보다 쉽게 읽힐 수 있습니다. <strong>예상 밖 결과 질문:</strong> 지갑에서 더 잘 읽혔다면 위치·거리·손의 움직임·주변 금속 같은 다른 원인은 무엇인가요? UID는 같지만 P4~P7을 못 읽었다면 ‘태그 감지’와 ‘메모리 접근’의 차이를 어떻게 설명할까요?</p>
        </section>

        <section class="lab-section" id="design" aria-labelledby="h-design" style="margin-top: var(--space-xl)">
          <h2 id="h-design"><span class="lab-section__n">1</span> 탐구 질문, 가설, 실험 설계</h2>
          <p>원리가 낯설면 <a href={url('/learn/nfc/')}>3단계</a>를, 화면 문구가 낯설면 <a href={url('/learn/device/#reader')}>2단계</a>를, 낯선 말은 <a href={url('/learn/glossary/')}>용어 사전</a>을 봅니다.</p>
          <div class="callout">
            <p><strong>준비 → 관찰 → 기록 → 분석 → 방어 → 보고서</strong> 순서로 진행합니다. 분석은 이 페이지의 그래프가 기본이며, Python·Colab은 선택 심화입니다. 거리·방향 확장은 기본 결과를 해석한 다음에 합니다.</p>
          </div>
          <details>
            <summary>A~E차시: 오늘의 완료 기준과 막혔을 때 돌아갈 곳</summary>
            <p>각 차시는 50분 제안입니다. 시간이 부족하면 마지막으로 마친 단계와 다음 할 일을 공책에 적고 이어갑니다.</p>
            <ol>
              <li><strong>A · 준비와 첫 관찰:</strong> <a href={url('/start/#first-scan')}>준비 확인</a>과 <a href={url('/learn/device/#reader')}>첫 태그 읽기</a>를 마치고 대기·감지 화면의 차이를 설명합니다. 기기가 없거나 읽히지 않으면 화면 안내로 경로를 정리하고 직접 확인하지 못했다고 남깁니다. 질문: “새로 읽었다는 근거는 무엇인가?”</li>
              <li><strong>B · 원리와 설계:</strong> <a href={url('/learn/nfc/')}>NFC 원리</a>와 <a href={url('/learn/security/')}>위협·방어</a>를 읽고 질문·가설·고정 조건·성공 기준을 아래에 적습니다. 예비 읽기가 안 되면 <a href="#pre">예비 실험</a>으로 돌아가고, 해결되지 않으면 실행하지 않은 설계안으로 제출합니다. 질문: “조건 외에 함께 바뀌는 것은 없는가?”</li>
              <li><strong>C · 관찰과 기록:</strong> 기본 세 조건을 각각 5회 시도하고 <a href="#record">결과</a>와 <a href="#data">CSV</a>를 남깁니다. 정상 대기에서 시도한 읽기 실패는 결과이고, 시작조차 못 한 시도는 실패 횟수로 꾸미지 않습니다. <a href="#procedure">재시작 절차</a>로 복구하고 못 한 횟수·이유는 메모합니다. 입력 기능이 안 되면 같은 항목을 공책에 적습니다. 질문: “다른 사람이 이 기록으로 시도를 재현할 수 있나?”</li>
              <li><strong>D · 분석과 방어:</strong> <a href="#chart">브라우저 그래프</a>의 성공/전체 횟수를 원자료와 대조하고 <a href="#interpret">결론·한계</a>와 <a href="#security">방어 제안</a>을 적습니다. 그래프가 비면 실제/데모 구분과 입력을 확인하고, 기능이 안 되면 공책에서 성공÷시도×100으로 계산합니다. 질문: “이 결과로 말할 수 없는 보안 주장은 무엇인가?”</li>
              <li><strong>E · 보고서와 자기 설명:</strong> <a href="#report">보고서</a>에 질문·방법·자료·해석·방어·한계를 연결하고 <a href="#interview">면접 질문</a>에 답합니다. 비어 있는 부분은 해당 기록으로 돌아가 보완하고, 재측정이 불가능하면 미완료와 후속 계획을 명시합니다. 질문: “가장 중요한 근거 한 가지와 다음 실험은 무엇인가?”</li>
            </ol>
            <p>자료가 사라졌다면 <a href="#data">CSV 가져오기</a>를 사용합니다. 백업이 없으면 관찰 사실을 공책에서 옮기고, 기억으로 수치를 채우지 않습니다. 자바스크립트를 쓸 수 없으면 공책의 표·계산·서술로 같은 보고서 순서를 완성합니다.</p>
          </details>
          <h3>준비물</h3>
          <ul>
            <li>이 기기. 리더는 More → RFID/NFC → Card Reader입니다. <Evidence kind="device" /></li>
            <li>실험용 NFC 태그 한 개. 구매 표기는 25mm 접착식 NTAG213, 기기 표시는 Ultralight-compatible입니다. 실제 칩 모델은 확인하지 못했습니다.</li>
            <li>자, 고정대나 테이프, 빈 지갑, 천 가방, 기록 도구</li>
          </ul>
          <p>처음에는 태그 한 개만 씁니다. 여러 태그나 금속을 처음부터 섞으면 원인을 나눌 수 없습니다.</p>

          <h3 id="pre">예비 실험: 잘 읽히는 자리 찾기</h3>
          <ol>
            <li>Card Reader를 열어 <code>Waiting for tag...</code>을 확인합니다.</li>
            <li>태그를 기기 뒷면에 대고 위치를 조금씩 옮겨 잘 읽히는 자리를 찾습니다.</li>
            <li>그 자리를 테이프로 표시합니다. 내부 코일 위치는 모르므로 이 표시를 기준으로 삼습니다.</li>
            <li>거리를 늘려 언제부터 읽히지 않는지 대강 봅니다. 이 결과에 맞춰 본 실험의 거리를 정합니다.</li>
            <li>예상한 UID가 표시되는지 적어 둡니다.</li>
          </ol>

          <h3 id="distance">거리 재는 기준</h3>
          <p>알 수 없는 내부 코일이 아니라 <strong>기기 뒷면 바깥 표면과 태그 표면 사이</strong>를 잽니다. 0cm는 바깥 표면에 닿은 상태입니다.</p>
          <p>지갑과 가방에서는 두 거리가 다릅니다. 기기에서 외피까지의 거리와, 안쪽 태그까지의 거리를 구분해 적으세요.</p>
          <ul>
            <li><strong>실제로 넣어 보기:</strong> 지갑에 넣으면 인식이 어떻게 되는지 전체 효과를 봅니다. 거리와 위치도 함께 바뀝니다.</li>
            <li><strong>재질만 비교하기:</strong> 태그 위치, 기기에서 태그까지의 총거리, 방향을 그대로 두고 사이에 놓는 재질만 바꿉니다.</li>
          </ul>

          <h3 id="procedure">한 번의 시도</h3>
          <ol>
            <li>태그를 뗍니다.</li>
            <li>목록으로 돌아갑니다. 대기 중이면 Cancel, 감지 후면 Exit입니다. Info를 보고 있으면 Back으로 리더 화면에 돌아온 뒤 나옵니다.</li>
            <li>Card Reader를 다시 열고 <code>Waiting for tag...</code>을 확인합니다.</li>
            <li>정한 조건대로 태그를 놓고 시간을 재기 시작합니다.</li>
            <li>성공 기준을 봅니다. 예: <strong>5초 안에 새로 <code>Tag detected</code>와 예상한 UID가 나오면 성공.</strong> 5초가 지나면 실패로 정하고 Cancel로 나옵니다.</li>
            <li>성공과 실패 모두 아래 표에 적습니다.</li>
          </ol>
          <p>전에 남아 있던 OK 화면을 새 성공으로 세면 안 됩니다. 성공 1은 새 <code>Tag detected</code>와 예상 UID가 모두 5초 안에 표시된 경우입니다. 다른 값이 나오거나 제한 시간 안에 읽히지 않으면 실패 0입니다. 시간은 사람이 직접 재며 이 사이트는 UID를 CSV에 저장하지 않습니다. 자동 반복 기능은 확인하지 못했으니 매번 위 순서를 따릅니다.</p>

          <h3>기본 실험: 배치 조건의 전체 효과부터</h3>
          <p>첫 완주는 단독·빈 지갑·천 가방 조건을 각각 5회, 총 15회 비교합니다. 같은 실험용 태그, 리더를 다시 여는 절차, 성공 기준을 유지하고 조건 순서는 번갈아 진행합니다. 실제 배치에서는 태그까지의 거리가 달라질 수 있으므로 매회 측정해 기록합니다. 이 설계는 ‘배치 조건 전체’의 차이를 봅니다. 결과만으로 지갑 재질의 효과라고 단정하지 않습니다.</p>
          <h3>기본 실험 뒤에 선택하는 확장</h3>
          <div class="table-wrap" tabindex="0" role="region" aria-label="회차별 실험 설계 예시">
