---
// 01 NFC 기본 실습. 다른 워크북과 같은 열세 장 틀(LabGuide)을 쓰고, NFC에만 있는 실측 골든 케이스,
// 예비 실험, 분석 노트북, EMV 비교, 면접 질문은 선택 슬롯으로 넣는다. 저장 키와 CSV, 서술 항목은 그대로다.
import LabGuide from '../../components/lab/LabGuide.astro';
import Think from '../../components/learn/Think.astro';
import TermLink from '../../components/learn/TermLink.astro';
import { Chart, CsvPanel, Interview, NoteFields, PythonPanel, Records, Report, SaveState, Summary } from '../../components/lab/NfcLab';
import { nfcColab } from '../../lib/colab';
import { nfcSummaryRows, pythonScript } from '../../lib/nfc';
import CodeBlock from '../../components/CodeBlock.astro';
import { nfcTable } from '../../lib/workbooks/render';
import output from '../../lib/workbooks/colab-output.json';
import { golden, guide, notes } from '../../lib/workbooks/nfc';
import { SOURCES } from '../../data/sources';
import { url } from '../../lib/url';

const pick = (...keys: (keyof typeof notes)[]) => keys.map((key) => ({ key, ...notes[key] }));
const reportSources = [SOURCES.emvco, SOURCES.ntag, SOURCES.metal, SOURCES.nistCsf].map((s) => ({ title: s.title, url: s.url ?? '' }));
---
<LabGuide guide={guide} scene={0} golden={nfcTable(golden)} expected={nfcSummaryRows(golden)} code={nfcColab(golden)} output={(output as Record<string, string>).nfc ?? ''} codeFile="nfc-experiment.csv">

  <div slot="mission-do" id="overview">
    <h4>A~E 차시: 오늘의 완료 기준과 막혔을 때 돌아갈 곳</h4>
    <p>각 차시는 50분 제안입니다. 시간이 부족하면 마지막으로 마친 장과 다음 할 일을 공책에 적고 이어 갑니다.</p>
    <ol>
      <li><strong>A 준비와 첫 관찰(1~3장):</strong> <a href={url('/start/#first-scan')}>준비 확인</a>과 <a href={url('/learn/device/#reader')}>첫 태그 읽기</a>를 마치고 대기와 감지 화면의 차이를 설명합니다. 기기가 없거나 읽히지 않으면 화면 안내로 경로를 정리하고 직접 확인하지 못했다고 남깁니다. 질문: 새로 읽었다는 근거는 무엇인가?</li>
      <li><strong>B 원리와 설계(4~5장):</strong> <a href={url('/learn/nfc/')}>NFC 원리</a>와 <a href={url('/learn/security/')}>위협과 방어</a>를 읽고 질문, 가설, 고정 조건, 성공 기준을 씁니다. 예비 실험이 안 되면 실행하지 않은 설계안으로 제출합니다. 질문: 조건 외에 함께 바뀌는 것은 없는가?</li>
      <li><strong>C 관찰과 기록(6장):</strong> 기본 세 조건을 각각 5회 시도하고 기록과 CSV를 남깁니다. 정상 대기에서 시도한 읽기 실패는 결과이고, 시작조차 못 한 시도는 실패 횟수로 꾸미지 않습니다. 질문: 다른 사람이 이 기록으로 시도를 재현할 수 있나?</li>
      <li><strong>D 분석과 방어(7~11장):</strong> 그래프의 성공/시도를 원자료와 대조하고 결론, 한계, 방어를 씁니다. 그래프가 비면 실제와 데모 구분을 확인하고, 기능이 안 되면 공책에서 성공 ÷ 시도 × 100으로 계산합니다. 질문: 이 결과로 말할 수 없는 보안 주장은 무엇인가?</li>
      <li><strong>E 보고서와 자기 설명(12~13장):</strong> 보고서에 질문, 방법, 자료, 해석, 방어, 한계, 응용을 연결하고 면접 질문에 답합니다. 비어 있는 부분은 해당 장으로 돌아가 보완하고, 재측정할 수 없으면 미완료와 후속 계획을 밝힙니다. 질문: 가장 중요한 근거 한 가지와 다음 실험은 무엇인가?</li>
    </ol>
    <h4>자바스크립트 없이 공책으로 완주하기</h4>
    <ol>
      <li>질문, 가설, 허가 범위와 고정 조건을 적습니다.</li>
      <li>2장 골든 케이스의 화면 순서와 확인한 표시를 그립니다.</li>
      <li>단독, 지갑, 가방 행을 각각 5개 만들고 성공은 1, 실패는 0, 시작하지 못한 시도는 미측정으로 구분합니다.</li>
      <li>조건별 성공 ÷ 시도 × 100을 계산하되, 결측을 0회 성공으로 바꾸지 않습니다.</li>
      <li>읽힘의 범위, 결제와의 차이, 방어, 한계, 다음 실험을 한 문단과 1분 설명으로 씁니다.</li>
    </ol>
    <p class="callout"><strong>막히면 순서를 되돌립니다.</strong> 태그가 안 읽히면 2장 대기 화면으로 돌아가 위치를 한 번만 바꾸고, 그래도 안 되면 미관찰로 남깁니다. 실제 관찰과 데모를 섞지 않습니다.</p>
  </div>

  <div slot="device-example" id="golden-case">
    <h4>실측 골든 케이스: 먼저 이 한 번을 통과</h4>
    <p>반복 실험 전에 새 태그를 읽고 화면 값을 확인하는 기본 경로를 한 번 완주합니다. 사용자가 제공한 화면에서는 <strong>PN532 리더, 7바이트 <TermLink id="uid" label="UID" />, ATQA 0044, SAK 00, MIFARE Ultralight-compatible 표시와 P4~P7 사용자 메모리 샘플</strong>을 확인했습니다. 이 값은 실험용 태그 화면의 관찰 범위이며, 실제 신용카드의 결제 인증, 암호 키, 복제 가능성을 뜻하지 않습니다.</p>
    <div class="table-wrap" tabindex="0" role="region" aria-label="NFC 골든 케이스 순서">
      <table>
        <caption>새 읽기 화면을 확인하는 순서</caption>
        <thead><tr><th scope="col">순서</th><th scope="col">화면과 행동</th><th scope="col">기록할 사실</th><th scope="col">완료 또는 대체</th></tr></thead>
        <tbody>
          <tr><td>1</td><td><code>Waiting for tag...</code></td><td>Card Reader가 새 대기 상태인지</td><td>이전 OK나 Info 화면이면 Back, Exit, Cancel로 다시 대기</td></tr>
          <tr><td>2</td><td>태그를 가까이 대기 → <code>Tag detected</code></td><td>새 UID가 예상 태그와 맞는지, 5초 안인지</td><td>맞으면 성공 후보, 안 보이면 미관찰로 기록</td></tr>
          <tr><td>3</td><td>Info에서 UID 길이, 타입, ATQA, SAK 확인</td><td>이번 읽기의 표시만 공책에 요약</td><td>이전 화면을 새 성공으로 세지 않음</td></tr>
          <tr><td>4</td><td>Next에서 P4~P7 표시 확인</td><td>사용자 메모리 샘플과 화면 페이지</td><td>페이지가 안 열리면 읽기 성공과 메모리 확인을 분리</td></tr>
          <tr><td>5</td><td>대기 화면으로 돌아와 기록</td><td>조건, 거리, 방향, 성공 1 또는 실패 0, 메모</td><td>시작하지 못한 시도는 미측정, 수치를 꾸미지 않음</td></tr>
        </tbody>
      </table>
    </div>
    <p><strong>예상 결과:</strong> 같은 태그를 같은 위치에 두면 UID와 태그 유형이 반복되고, 단독 조건이 지갑이나 가방보다 쉽게 읽힐 수 있습니다. <strong>예상 밖 결과 질문:</strong> 지갑에서 더 잘 읽혔다면 위치, 거리, 손의 움직임, 주변 금속 같은 다른 원인은 무엇인가요? UID는 같지만 P4~P7을 못 읽었다면 태그 감지와 메모리 접근의 차이를 어떻게 설명할까요?</p>
  </div>

  <div slot="design-explain">
    <h4 id="pre">예비 실험: 잘 읽히는 자리 찾기</h4>
    <ol>
      <li>Card Reader를 열어 <code>Waiting for tag...</code>을 확인합니다.</li>
      <li>태그를 기기 뒷면에 대고 위치를 조금씩 옮겨 잘 읽히는 자리를 찾습니다.</li>
      <li>그 자리를 테이프로 표시합니다. 내부 코일 위치는 모르므로 이 표시를 기준으로 삼습니다.</li>
      <li>거리를 늘려 언제부터 읽히지 않는지 대강 봅니다. 이 결과에 맞춰 본 실험의 거리를 정합니다.</li>
      <li>예상한 UID가 표시되는지 확인합니다. UID 값은 적지 않습니다.</li>
    </ol>
    <h4 id="distance">거리 재는 기준</h4>
    <p>알 수 없는 내부 코일이 아니라 <strong>기기 뒷면 바깥 표면과 태그 표면 사이</strong>를 잽니다. 0cm는 바깥 표면에 닿은 상태입니다. 지갑과 가방에서는 기기에서 외피까지의 거리와 안쪽 태그까지의 거리가 다르므로 둘을 구분해 적습니다.</p>
    <ul>
      <li><strong>실제로 넣어 보기:</strong> 지갑에 넣으면 인식이 어떻게 되는지 전체 효과를 봅니다. 거리와 위치도 함께 바뀝니다. 기본 실험은 이 방식입니다.</li>
      <li><strong>재질만 비교하기:</strong> 태그 위치, 기기에서 태그까지의 총거리, 방향을 그대로 두고 사이에 놓는 재질만 바꿉니다. 확장 실험에서 씁니다.</li>
    </ul>
  </div>

  <div slot="design-example">
    <div class="table-wrap" tabindex="0" role="region" aria-label="회차별 실험 설계 예시">
      <table>
        <caption>실행 계획 예시입니다. 관찰 결과가 아니라 예비 실험 후 조정할 계획입니다.</caption>
        <thead><tr><th scope="col">회차</th><th scope="col">바꾸는 변수</th><th scope="col">고정하는 것</th><th scope="col">시도 수</th></tr></thead>
        <tbody>
          <tr><td>완주</td><td>배치: 단독, 빈 지갑, 천 가방</td><td>같은 태그, 리더 절차, 방향, 5초 성공 기준</td><td>3 × 5회 = 15회</td></tr>
          <tr><td>확장 A</td><td>단독 조건의 거리 3단계</td><td>태그, 방향, 표시 위치, 절차</td><td>3 × 5회 = 15회</td></tr>
          <tr><td>확장 B</td><td>방향 또는 내용물 중 하나</td><td>나머지 조건 전부</td><td>질문과 예비 결과에 맞춰 결정</td></tr>
        </tbody>
      </table>
    </div>
    <p>기본 실험에서는 실제 배치의 거리를 그대로 기록하고, 거리 자체의 영향을 알고 싶을 때만 확장 A에서 거리 하나를 바꿉니다.</p>
    <Think q="가방 조건에서 태그를 매번 다른 곳에 넣으면 무엇이 문제인가요?">
      <p>위치와 거리까지 함께 바뀌어 가방 때문인지 위치 때문인지 나눌 수 없습니다. 태그를 안쪽에 고정하면 비교가 쉬워집니다.</p>
    </Think>
    <Think q="다섯 번 모두 성공하면 항상 인식된다고 할 수 있나요?">
      <p>아닙니다. 5회의 100%는 이 조건에서 5번 성공했다는 뜻입니다. 절대적인 보장으로 해석하지 않습니다.</p>
    </Think>
    <Think q="실패가 나왔을 때 무엇부터 나눠 생각해야 하나요?">
      <p>실제 인식 실패인지, 화면을 다시 시작하지 않은 실수인지, 기록 저장 문제인지 구별합니다. 같은 UID가 다시 나오는지도 확인합니다.</p>
    </Think>
  </div>

  <div slot="design" id="design"><NoteFields client:load fields={pick('question', 'motivation', 'hypothesis', 'independent', 'controlled', 'plan', 'tag', 'reader')} /></div>

  <div slot="record" id="record">
    <SaveState client:load />
    <div class="callout callout--warn"><p><strong>실제 신용카드, 체크카드, 교통카드, 학생증은 쓰지 않습니다.</strong> 직접 산 실험용 NFC 태그만 사용합니다.</p></div>
    <Records client:load />
  </div>
  <div slot="data" id="data">
    <p>브라우저 저장은 이 기기에만 남고 인터넷 사용 기록을 지우면 사라질 수 있습니다. 실험이 끝날 때마다 내려받아 두세요.</p>
    <CsvPanel client:load />
    <p class="field__help">표 프로그램에서 수식으로 실행되지 않도록 =, +, -, @로 시작하는 글 앞에는 작은따옴표를 붙여 저장합니다. 다시 가져오면 원래 값으로 돌아옵니다.</p>
  </div>

  <div slot="analysis" id="chart">
    <Summary client:load />
    <Chart client:load />
  </div>
  <div slot="interpret" id="interpret"><NoteFields client:load fields={pick('interpretation', 'conclusion')} /></div>

  <div slot="colab-example" id="python">
    <h4>더 깊이: 분석 노트북으로 그림 다섯 장 만들기</h4>
    <p>기기와 이 웹사이트는 자동 연결되지 않습니다. 기록 <TermLink id="csv" label="CSV" />를 <TermLink id="colab" label="Colab" />에 옮겨 분석합니다. <TermLink id="uid" label="UID" />, 실명, 실제 <TermLink id="ssid" label="SSID" />와 <TermLink id="bssid" label="BSSID" />, 개인 메모는 올리지 마세요.</p>
    <ol>
      <li>6장에서 <code>nfc-experiment.csv</code>를 내려받습니다. 분석에 필요한 것은 관찰 CSV 하나입니다.</li>
      <li><a href="https://colab.research.google.com/" target="_blank" rel="noopener noreferrer">Google Colab</a>에서 File → Upload notebook을 고르고 아래에서 내려받은 <code>nfc-analysis.ipynb</code>를 올립니다.</li>
      <li>첫 코드 셀을 실행해 <code>nfc-experiment.csv</code>를 올린 뒤 Runtime → Run all을 실행합니다.</li>
      <li>그림마다 성공/시도 수와 축을 확인하고, 마지막 셀에서 내려받은 <code>nfc-analysis-results.zip</code>을 보관합니다.</li>
    </ol>
    <p><TermLink id="groupby" label="groupby" />는 조건별 시도 수와 성공 수를 세고, <TermLink id="recognition-rate" label="인식률" />은 성공/시도입니다. <TermLink id="wilson-interval" label="Wilson 구간" />은 표본이 적을 때의 불확실성을 보여 주는 참고선이지, 보안 보장이나 가설 검정이 아닙니다. 지갑과 가방 조건은 거리도 함께 달라질 수 있어 거리 그래프만으로 거리의 단독 효과를 결론 내리지 않습니다.</p>
    <PythonPanel client:load />
    <CodeBlock code={pythonScript()} file="nfc-analysis.py" label="nfc-analysis.py · 노트북과 같은 코드" />
    <figure class="nfc-example">
      <img src="/images/nfc-colab-example.svg" alt="가상 자료로 만든 NFC Colab 결과 예시. 왼쪽은 조건별 성공과 실패 횟수, 오른쪽 위는 거리별 인식률, 오른쪽 아래는 조건과 거리별 성공/시도 히트맵이다." loading="lazy" width="1200" height="760" style="display: block; width: 100%; height: auto;" />
      <figcaption><strong>모양을 익히기 위한 가상 예시입니다.</strong> 단독 5/5, 지갑 3/5, 가방 2/5라는 임의의 값으로 그렸습니다. 실제 실험의 예상값이나 정답이 아니며, 학생의 그림은 측정 결과에 따라 달라집니다.</figcaption>
    </figure>
    <p class="field__help">로컬에서 실행하려면 <code>nfc-analysis.py</code>와 CSV를 같은 폴더에 두고 <TermLink id="pandas" label="pandas" />와 <TermLink id="matplotlib" label="matplotlib" />를 설치합니다.</p>
  </div>

  <div slot="trouble-do" id="unexpected"><NoteFields client:load fields={pick('unexpected', 'causes', 'followup')} /></div>

  <div slot="threats-example" id="security">
    <h4>보안 관점별로 이번 실험이 확인한 것</h4>
    <div class="table-wrap" tabindex="0" role="region" aria-label="보안 속성과 이번 실험의 범위">
      <table>
        <thead><tr><th scope="col">보안 관점</th><th scope="col">이 실험에서 확인하는 것</th><th scope="col">확인하지 않는 것</th></tr></thead>
        <tbody>
          <tr><th scope="row"><TermLink id="cia" label="기밀성" /></th><td>허가된 리더가 실험 태그를 이 조건에서 읽는지</td><td>개인정보 유출이나 다른 리더의 접근 가능성</td></tr>
          <tr><th scope="row"><TermLink id="cia" label="무결성" /></th><td>확인하지 않음. 이 실험은 읽기만 합니다.</td><td>태그 값의 변조 방지, 쓰기 권한, 암호 인증</td></tr>
          <tr><th scope="row"><TermLink id="cia" label="가용성" /></th><td>반복 판독의 성공과 실패를 관찰</td><td>방해나 서비스 거부에 대한 저항성. 그런 공격은 실험하지 않습니다.</td></tr>
          <tr><th scope="row"><TermLink id="authn-authz" label="인증" />과 복제</th><td>확인하지 않음. UID가 보인다고 복제나 인증을 시험한 것이 아닙니다.</td><td>위조 태그 판별, 암호 응답, 복제 저항성</td></tr>
        </tbody>
      </table>
    </div>
    <div class="table-wrap" tabindex="0" role="region" aria-label="관찰 결과와 방어 해석">
      <table>
        <thead><tr><th scope="col">관찰</th><th scope="col">말할 수 있는 것</th><th scope="col">방어 관점</th></tr></thead>
        <tbody>
          <tr><th scope="row">태그가 읽힘</th><td>시험한 배치, 거리, 방향에서 5초 안에 읽혔습니다.</td><td>민감한 값은 읽기 쉬운 태그에 저장하지 말고, 필요한 정보만 두며 접근 제어를 설계합니다.</td></tr>
          <tr><th scope="row">태그가 읽히지 않음</th><td>그 설정에서 정한 시간 안에 확인하지 못했습니다. 보안 기능이 작동했다는 증거는 아닙니다.</td><td>위치, 방향, 리더 상태 같은 다른 원인을 나눠 확인합니다. 가방이나 지갑만을 보안 통제로 보지 않습니다.</td></tr>
          <tr><th scope="row">조건별 차이가 작거나 들쑥날쑥함</th><td>표본 수와 측정 오차 안에서 차이가 뚜렷하지 않을 수 있습니다.</td><td>재시도, 오류 기록, 정보 최소화 같은 시스템 방어를 우선하고 물리 차폐는 보조 수단으로만 검토합니다.</td></tr>
        </tbody>
      </table>
    </div>
    <h4 id="emv"><TermLink id="emv" label="EMV" />란? 일반 태그와 결제 칩 구분하기</h4>
    <p><TermLink id="emv" label="EMV" />는 원래 규격을 함께 만든 Europay, Mastercard, Visa의 첫 글자에서 온 이름입니다. 지금은 결제 칩과 비접촉 결제 단말기가 데이터를 주고받는 방법을 정한 규격군을 가리킵니다. EMV 비접촉 결제에서는 칩이 거래 때마다 <TermLink id="cryptogram" label="일회용 보안 코드(cryptogram)" />를 만들며, 결제 단말기와 발급사가 거래를 확인하는 데 씁니다. 자세한 흐름은 <a href={SOURCES.emvco.url} target="_blank" rel="noopener noreferrer">EMVCo의 비접촉 칩 설명</a>을 참고하세요.</p>
    <p><strong>이번 ESP32-DIV 실험은 EMV 결제 시험이 아닙니다.</strong> 실험용 NTAG213 같은 일반 태그의 메모리 읽기와 EMV 결제 칩의 거래 인증은 목적과 보안 기능이 다릅니다. 둘 다 13.56MHz 근거리 통신이라는 공통점만으로 보안 수준을 비교할 수 없으며, 이번 인식률은 결제 보안에 대해 아무것도 증명하지 않습니다.</p>
    <div class="table-wrap" tabindex="0" role="region" aria-label="일반 태그와 EMV 결제 비교">
      <table>
        <thead><tr><th scope="col">항목</th><th scope="col">실험용 태그 (NTAG213 예)</th><th scope="col">EMV 비접촉 결제</th></tr></thead>
        <tbody>
          <tr><th scope="row">하는 일</th><td>메모리에 저장된 값을 읽고 씁니다. 사용자 메모리 144바이트, 7바이트 UID.</td><td>칩이 암호 기능을 써서 결제를 처리합니다.</td></tr>
          <tr><th scope="row">결제 때의 값</th><td>결제 기능이 없습니다.</td><td>EMVCo는 거래마다 일회용 보안 코드를 만든다고 설명합니다.</td></tr>
          <tr><th scope="row">읽기의 의미</th><td>잠그지 않았다면 내용을 그대로 읽고 다른 태그에 옮기기 쉽습니다.</td><td>일부 정보를 읽는 것과, 결제가 되는 복제본을 만드는 것은 다른 일입니다.</td></tr>
          <tr><th scope="row">근거</th><td><a href={SOURCES.ntag.url} rel="noopener noreferrer" target="_blank">NXP 데이터시트</a></td><td><a href={SOURCES.emvco.url} rel="noopener noreferrer" target="_blank">EMVCo</a></td></tr>
        </tbody>
      </table>
    </div>
  </div>
