---
import LabGuide from '../../components/lab/LabGuide.astro';
import { WifiChart, WifiData, WifiInterview, WifiNotes, WifiRecord, WifiReport } from '../../components/lab/WifiRssiLab';
import { INTERVIEW } from '../../lib/workbooks/interview';
import { wifiColab } from '../../lib/colab';
import { wifiSummaryRows } from '../../lib/workbook';
import { noteFields, noteLabels, wifiTable } from '../../lib/workbooks/render';
import output from '../../lib/workbooks/colab-output.json';
import { golden, guide } from '../../lib/workbooks/wifi-rssi';

const pick = (...keys: string[]) => noteFields(guide, keys);
---
<LabGuide guide={guide} scene={1} golden={wifiTable(golden)} expected={wifiSummaryRows(golden)} code={wifiColab(golden)} output={(output as Record<string, string>)['wifi-rssi'] ?? ''} codeFile="wifi-rssi-observations.csv">
  <WifiNotes slot="design" client:load fields={pick('question', 'hypothesis', 'controls')} />
  <WifiRecord slot="record" client:load golden={golden} />
  <WifiData slot="data" client:load />
  <WifiChart slot="analysis" client:load />
  <WifiNotes slot="interpret" client:load fields={pick('interpretation', 'conclusion')} />
  <WifiNotes slot="defense" client:load fields={pick('defense', 'limits')} />
  <WifiNotes slot="application" client:load fields={pick('application')} />
  <WifiInterview slot="interview" client:load title={guide.title} questions={INTERVIEW['wifi-rssi']} explain={pick('explain')[0]} />
  <WifiReport slot="report" client:load labels={noteLabels(guide)} />
</LabGuide>
