---
import Base from '../../layouts/Base.astro';
import Evidence from '../../components/Evidence.astro';
import Sources from '../../components/Sources.astro';
import WifiRssiLab from '../../components/lab/WifiRssiLab';
import TermLink from '../../components/learn/TermLink.astro';
import { url } from '../../lib/url';

const toc = [
  ['design', '질문과 실험 설계'],
  ['record', '관찰값 기록'],
  ['chart', '방별 RSSI 비교'],
  ['data', 'CSV 백업과 복구'],
  ['interpret', '해석과 방어 설계'],
  ['report', '보고서와 면접'],
];
---
<Base title="방마다 Wi-Fi가 끊기는 이유는? | 실험 워크북" description="같은 Wi-Fi AP의 RSSI와 채널을 방·거리·시각별로 직접 기록하고 그래프, CSV, 보고서로 정리합니다.">
  <div class="wrap">
    <header class="page-head">
      <p class="page-back"><a href={url('/lab/')}>실험 워크북 목록</a></p>
      <h1>방마다 Wi-Fi가 끊기는 이유는?</h1>
      <p class="tags"><span class="tag tag--device">웹 워크북 사용 가능</span></p>
      <p class="lead">같은 공유기의 신호를 방·거리·시각별로 기록하고, 숫자로 확인한 사실과 보안 추정을 구분합니다.</p>
    </header>

    <div class="doc">
      <div class="doc__main">
        <div class="callout callout--warn">
          <p><strong>이 ESP32-DIV 기기의 Wi-Fi 스캔 실행은 아직 확인하지 못했습니다.</strong> 이 워크북은 내 공유기나 휴대폰에서 직접 확인한 값을 사람이 옮겨 적는 웹 기록 도구입니다. 자동 측정·패킷 수집·침입 탐지를 하지 않습니다. <Evidence kind="unverified" /></p>
        </div>
        <noscript><p class="callout callout--warn">기록·그래프·CSV·보고서 기능은 자바스크립트가 켜져 있어야 동작합니다. 아래 실험 절차와 예시 표는 그대로 읽을 수 있습니다.</p></noscript>
        <section class="lab-section" aria-labelledby="h-w-class">
          <h2 id="h-w-class">선택 W: 관찰부터 방어 보고서까지</h2>
          <p><a href={url('/learn/#classes')}>기본 A~E 수업</a> 뒤에 선택하는 1~2차시 활동입니다. <a href={url('/learn/network/#scan')}>Wi-Fi 탐색과 RSSI</a>를 먼저 읽습니다. 브라우저의 방별 요약·차트가 기본 분석이며, CSV의 Python 분석은 선택입니다. 이 웹 기록 도구의 사용 가능 상태와 이 기기의 Wi-Fi 실행 미검증 상태를 구분합니다.</p>
          <ol>
            <li><strong>준비·설계:</strong> <a href="#design">준비물과 변수</a>를 확인하고 AP 가명·질문·가설·반복 계획을 적으면 완료입니다. RSSI를 볼 도구가 없으면 사용 허락을 받은 휴대폰·PC를 확인하거나 데모로 기록·분석 연습만 합니다. 질문: “신호 세기와 인터넷 속도는 같은가?”</li>
            <li><strong>관찰·기록:</strong> <a href="#record">관찰값</a>을 방별로 반복 입력하고 상태·단위·결측 이유를 구분하면 완료입니다. AP를 못 찾음과 측정 자체를 못 함은 다릅니다. 같은 AP·방향·대기 조건을 확인해 다시 관찰하되, 해결되지 않으면 빈 RSSI와 이유를 남깁니다. 질문: “비교 조건을 정말 같게 유지했나?”</li>
            <li><strong>분석:</strong> <a href="#chart">방별 요약·차트</a>에서 유효 표본 수·중앙값·범위·결측 수를 비교하면 완료입니다. 값이 없으면 실제/데모 보기와 관찰 상태를 확인합니다. 모두 결측이면 비교 불가라고 쓰고, 기능이 안 되면 공책으로 유효 값만 정렬·계산합니다. 질문: “결측을 0으로 넣으면 결론이 어떻게 달라지나?”</li>
            <li><strong>방어·보고서:</strong> <a href="#interpret">해석·방어</a>에 관찰 근거·다른 원인·방어 제안을 적고 <a href="#report">보고서와 면접</a>으로 설명하면 완료입니다. 자료가 적으면 침입이나 원인을 단정하지 않고 한계·추가 측정 계획을 남깁니다. 질문: “내 자료가 지지하는 주장과 아직 검증하지 못한 주장은 무엇인가?”</li>
          </ol>
          <p><strong>마무리와 복구:</strong> <a href="#data">관찰 CSV와 탐구 서술 CSV</a>를 함께 내려받습니다. 저장 경고가 나오면 창을 닫기 전에 백업하고, 자료를 옮길 때 두 파일을 각각 가져와 미리보기를 확인합니다. 백업이 없으면 공책에서 확인 가능한 값만 복원합니다. 데모로 연습했다면 실제 관찰 결과로 제출하지 않습니다.</p>
          <p>기기·시간·자바스크립트가 준비되지 않았다면 아래 절차로 공책에 설계·표·해석·보고서를 남길 수 있습니다. 실제 관찰을 못 했다는 한계를 표시하고, 준비된 뒤 <a href="#design">설계 확인</a>부터 재개합니다.</p>
        </section>

        <section class="lab-section" id="design" aria-labelledby="h-design">
          <h2 id="h-design"><span class="lab-section__n">1</span> 질문과 실험 설계</h2>
          <p>탐구 질문은 “어느 방의 신호가 약한가?”에서 시작해 “왜 그렇게 보였고, 다른 원인과 어떻게 구분할까?”로 이어집니다. 먼저 <a href={url('/learn/network/#scan')}>Wi-Fi 탐색 흐름</a>과 <TermLink id="rssi" label="RSSI" />를 읽어도 좋습니다.</p>

          <h3>준비물과 안전 범위</h3>
          <ul>
            <li>내가 관리하거나 사용 허락을 받은 공유기 한 대</li>
            <li><TermLink id="rssi" label="RSSI" />와 채널을 보여 주는 내 휴대폰·PC 또는 이 기기(기기 기능은 실행 확인 뒤 사용)</li>
            <li>방별 거리와 위치를 적을 평면도나 공책</li>
            <li><strong>타인 네트워크 접속, 가짜 AP 생성, 재밍, 패킷·자격 증명 수집은 하지 않습니다.</strong></li>
          </ul>

          <h3>변수 정하기</h3>
          <dl class="facts">
            <div><dt>바꾸는 것</dt><dd>방·위치 또는 시간대 가운데 한 번에 하나</dd></div>
            <div><dt>고정하는 것</dt><dd>같은 <TermLink id="ap" label="AP" />, 측정 기기, 기기 높이·방향, 한 위치의 대기 시간</dd></div>
            <div><dt>기록하는 것</dt><dd>방, 거리, <TermLink id="rssi" label="RSSI" />(<TermLink id="dbm" label="dBm" />), 채널, 시각, 조건, AP 가명</dd></div>
            <div><dt>반복</dt><dd>장소 3곳에서 각각 5회 권장. 장소 순서를 번갈아 배치하고 같은 시간 조건으로 비교</dd></div>
          </dl>

          <h3>한 번의 관찰 절차</h3>
          <ol>
            <li>내 <TermLink id="ap" label="AP" />를 AP-A처럼 가명으로 정합니다. 실제 <TermLink id="ssid" label="SSID" />와 <TermLink id="bssid" label="BSSID" />는 워크북에 입력하지 않습니다.</li>
            <li>공유기와 측정 기기의 높이·방향을 정하고 방·거리를 적습니다.</li>
            <li>Wi-Fi 목록을 새로 고친 뒤 같은 AP의 RSSI와 채널을 읽습니다. 탐색은 접속이나 인터넷 사용과 다릅니다.</li>
            <li>RSSI가 보이면 <strong>값 관찰됨</strong>, AP를 찾지 못하면 <strong>신호를 찾지 못함</strong>, 측정 자체를 못 했으면 <strong>측정하지 못함</strong>으로 구분합니다.</li>
            <li>다음 방으로 이동해 관찰하고 다시 돌아옵니다. 방별로 5회가 되도록 순서를 번갈아 반복합니다.</li>
          </ol>
          <p>채널을 확인하지 못했으면 빈 값으로 둡니다. 거리는 공유기 바깥 표면과 측정 기기 바깥 표면 사이를 같은 방법으로 재고, 기기 높이와 방향도 기록합니다.</p>
          <p><TermLink id="rssi" label="RSSI" />는 보통 음수입니다. 예를 들어 -45<TermLink id="dbm" label="dBm" />은 -80dBm보다 0에 가까워 더 강합니다. 신호를 찾지 못한 기록이나 측정하지 못한 기록을 0dBm으로 바꾸면 요약값이 왜곡되므로 빈 값으로 남깁니다.</p>

          <div class="table-wrap" tabindex="0" role="region" aria-label="Wi-Fi 관찰 기록 예시">
            <table>
              <caption>형식 예시이며 실제 측정값이 아닙니다.</caption>
              <thead><tr><th>방</th><th>상태</th><th>RSSI</th><th>채널</th><th>해석할 때 주의</th></tr></thead>
              <tbody>
                <tr><td>거실</td><td>값 관찰됨</td><td>-48dBm</td><td>6</td><td>이 한 번의 값만으로 안정성을 확정하지 않음</td></tr>
                <tr><td>방 2</td><td>신호를 찾지 못함</td><td>빈 값</td><td>빈 값</td><td>0dBm이나 공격으로 바꾸지 않음</td></tr>
                <tr><td>현관</td><td>측정하지 못함</td><td>빈 값</td><td>빈 값</td><td>결측 이유를 메모하고 평균에서 제외</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <noscript>
          <section class="lab-section" aria-labelledby="h-paper">
            <h2 id="h-paper">공책으로 이어서 정리하기</h2>
            <p>방·조건·거리·시각·AP 별칭·관찰 상태·RSSI·채널·메모를 한 줄씩 적습니다. 신호 없음과 미측정은 별도로 세고 RSSI는 빈 칸으로 남깁니다.</p>
            <p>방별 유효 RSSI를 정렬해 중앙값·최솟값·최댓값과 유효 표본 수를 구합니다. n이 짝수면 가운데 두 값의 평균이 중앙값입니다.</p>
            <p>보고서는 궁금했던 장면→질문·가설→고정 조건·반복 설계→원자료·요약→해석·결론→예상 밖 결과·추가 실험→보안·방어→한계와 출처 순서로 씁니다. RSSI 차이와 침입의 증거를 구분하고 내 경험을 1분으로 설명해 보세요.</p>
          </section>
        </noscript>
        <WifiRssiLab client:load />
        <Sources ids={['espScan', 'wifiSecurity']} />
      </div>

      <aside class="doc__aside toc wifi-toc" aria-label="이 워크북 목차">
        <h2>진행 순서</h2>
        <ol>{toc.map(([id, label], index) => <li><a href={`#${id}`}><span class="lab-section__n">{index + 1}</span>&nbsp; {label}</a></li>)}</ol>
        <p class="field__help">값을 입력하면 이 브라우저에만 저장됩니다. 실험을 마칠 때 CSV를 내려받으세요.</p>
      </aside>
    </div>
  </div>
</Base>

<style>
  :global(html:not(.js)) .wifi-toc { display: none; }
</style>
