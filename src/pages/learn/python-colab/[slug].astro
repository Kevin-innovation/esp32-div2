---
// Python·pandas·Colab 과정 2~6차시. 내용은 data/pythonCourse.ts·pythonProject.ts, 출력은 check-python-course.ts의 실제 실행 결과.
import LearnLayout from '../../../layouts/LearnLayout.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import CourseNav from '../../../components/learn/CourseNav.astro';
import LessonStep from '../../../components/learn/LessonStep.astro';
import { LESSONS } from '../../../data/pythonCourseMap';
import { lessonFiles } from '../../../data/pythonFiles';
import type { Lesson } from '../../../data/pythonCourse';
import type { SourceId } from '../../../data/sources';
import out from '../../../data/python-course-output.json';

export function getStaticPaths() {
  return LESSONS.map((lesson) => ({ params: { slug: lesson.slug }, props: { lesson } }));
}
const { lesson } = Astro.props as { lesson: Lesson };
const files = lessonFiles(lesson);
const expected = (out as Record<string, { out: string }>)[`file/${lesson.slug}/teacher`].out;
const SOURCES: Record<string, SourceId[]> = {
  basics: ['pythonTutorial'],
  functions: ['pythonTutorial', 'pythonRe', 'colabFiles'],
  table: ['pandasReadCsv', 'pandasIndexing', 'pandasMissing'],
  group: ['pandasGroupby', 'pandasCrosstab', 'pandasReshape', 'mplBar'],
  project: ['pandasReadCsv', 'pandasGroupby', 'mplBar', 'colabFiles'],
};
const writes = lesson.steps.filter((s) => s.write).length;
---
<LearnLayout
  title={`${lesson.n}차시 ${lesson.title}`}
  heading={`${lesson.n}차시 ${lesson.title}`}
  lead={lesson.goal}
  description={`Python·pandas·Colab 과정 ${lesson.n}차시: ${lesson.short}. 미션 9장 코드와 연결한 예제, 빈칸, 직접 작성 과제와 확인 셀.`}
  toc={[['plan', '이 차시'], ...lesson.steps.map((s, i) => [`step-${s.id}`, lesson.chain ? s.title : `${i + 1}. ${s.title.split(':')[0]}`] as [string, string]), ['files', '학생용·교사용 파일'], ['h-course-end', '차시 마무리']]}
  sourcesChecked="2026-11-11"
  sources={SOURCES[lesson.slug]}
>
  <section id="plan" aria-labelledby="h-plan">
    <h2 id="h-plan">이 차시</h2>
    <dl class="facts">
      <div><dt>소요</dt><dd>약 {lesson.minutes}분{lesson.minutes > 45 ? ' (45분 두 번으로 나눠도 됩니다)' : ''}</dd></div>
      <div><dt>먼저 할 것</dt><dd>{lesson.prereq}</dd></div>
      <div><dt>배우는 것</dt><dd>{lesson.short}</dd></div>
      <div><dt>산출물</dt><dd>{lesson.product}</dd></div>
    </dl>
    {lesson.chain ? (
      <p>단계마다 앞 단계의 결과(rows, table, data, summary…)를 이어 씁니다. 한 Colab 노트에서 위에서부터 차례로 실행하고, 런타임이 다시 시작되면 1단계부터 다시 실행합니다. 각 단계는 <strong>빈칸 코드 → 힌트 → 완성 코드와 출력 → 확인 셀 → 함정 → 이유 → 변형 → 미션 원문</strong> 순서입니다.</p>
    ) : (
      <p>단계마다 <strong>예제 보기 → 빈칸 채우기 → 힌트 → 빈 셀에 직접 작성(확인 셀) → 정답 → 함정 → 이유 → 변형 문제 → 미션 원문으로 돌아가기</strong> 순서로 진행합니다. 이 차시의 직접 작성 과제는 {writes}개입니다. 예제는 각각 새 셀에서 따로 실행해도 같은 출력이 나옵니다.</p>
    )}
    <p class="small muted">출력은 이 사이트가 Python 3.13·pandas 2.3에서 실제로 실행한 결과입니다. Colab의 버전에 따라 오류 문장이 조금 다를 수 있지만 오류 이름은 같습니다.</p>
  </section>

  {lesson.steps.map((step, i) => <LessonStep lesson={lesson} step={step} i={i} />)}

  <section id="files" aria-labelledby="h-files">
    <h2 id="h-files">학생용·교사용 파일</h2>
    <p><strong>학생용 틀은 그대로 실행되지 않습니다.</strong> 빈칸(___)과 직접 작성 칸(<code>raise NotImplementedError</code>)이 남아 있어 첫 빈칸에서 멈추는 것이 정상입니다. ‘단계’ 주석마다 셀을 나눠 붙여 넣고 위에서부터 채웁니다. 모든 칸을 채우면 확인 셀이 차례로 ‘확인 통과’를 출력합니다.</p>
    <CodeBlock code={files.student} file={`${files.name}-student.py`} label={`${files.name}-student.py · 학생용 틀(실행 안 됨)`} />
    <details>
      <summary>교사용 완성본과 예상 출력</summary>
      <p class="small">완성본은 끝까지 실행되며 출력이 아래 예상 출력과 같습니다(검사 스크립트가 실행해 대조).</p>
      <CodeBlock code={files.teacher} file={`${files.name}-teacher.py`} label={`${files.name}-teacher.py · 교사용 완성본`} />
      <CodeBlock kind="output" code={expected} file={`${files.name}-expected.txt`} label={`${files.name}-expected.txt · 예상 출력`} save={true} />
    </details>
  </section>

  <CourseNav n={lesson.n} />
</LearnLayout>
